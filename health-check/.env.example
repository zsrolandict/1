# ── Bejelentkezés (Supabase, EU régió) ─────────────────────────────
# Beállítva: minden AI-végpont bejelentkezett belső felhasználót kér.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Csak fejlesztői gépen: Supabase nélkül is engedi az AI-végpontokat.
# Éles buildben (NODE_ENV=production) hatástalan.
ALLOW_DEMO_API=

# ── Claude API – interjúelemzés és AI-kérdésjavaslat (csak szerveren) ──
ANTHROPIC_API_KEY=

# ── Azure AI Speech – hangfájl → magyar leirat (EU régió) ──────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
