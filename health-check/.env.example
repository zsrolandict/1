# ── Bejelentkezés (Supabase, EU régió) ─────────────────────────────
# Beállítva: minden AI-végpont bejelentkezett belső felhasználót kér.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CSAK SZERVEREN (soha nem NEXT_PUBLIC_): az AI-felülvizsgálat rögzítése
# használja (append_ai_review). Részletek: docs/12-elesites-biztonsag.md
SUPABASE_SERVICE_ROLE_KEY=
# Engedélyezett e-mail domainek vesszővel (pl. iroda.hu,csoport.hu);
# üresen minden meghívott cím beléphet. Meghívás nélkül senki.
ALLOWED_EMAIL_DOMAINS=

# Csak fejlesztői gépen: Supabase nélkül is engedi az AI-végpontokat.
# Éles buildben (NODE_ENV=production) hatástalan.
ALLOW_DEMO_API=

# ── AI-szolgáltató (interjú- és dokumentumelemzés, kérdésjavaslat) ─
# Elég EGY kulcs. Ha mindkettő meg van adva, az AI_PROVIDER dönt
# (anthropic | gemini); üresen az Anthropic az elsődleges.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Google AI Studio kulcs: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcionális, alapértelmezés: gemini-flash-latest (mindig a legújabb Flash)
GEMINI_MODEL=

# ── Hang / videó → magyar leirat ────────────────────────────────────
# TRANSCRIBE_PROVIDER = azure | gemini; üresen az elérhető kulcs dönt.
# Gemini: a fenti GEMINI_API_KEY elég (hangot és videót is fogad).
TRANSCRIBE_PROVIDER=
# Azure AI Speech (EU régió):
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ── Adatkezelés és korlátok (éles üzem) ─────────────────────────────
# Éles buildben (npm run build / start) az AI csak akkor fut, ha van
# adatfeldolgozói szerződés (DPA) a fenti szolgáltatóval, fizetős, EU-s
# adatkezeléssel. Ingyenes Gemini-kulccsal NE állítsd be.
AI_DPA_CONFIRMED=
# Hívásszám-korlát felhasználónként, óránként (alapértelmezés: 40 / 10)
AI_RATE_LIMIT_PER_HOUR=
TRANSCRIBE_RATE_LIMIT_PER_HOUR=
